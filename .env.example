# TalkEase Environment Configuration

# Optional: Add your Hugging Face API key here (get one free at https://huggingface.co/settings/tokens)
# If left blank, TalkEase runs with intelligent built-in multilingual responses and lesson templates.
HUGGINGFACE_API_KEY=

# Optional: Firebase Service Account JSON credentials path (if using Google Cloud Firestore)
FIREBASE_CREDENTIALS_PATH=
